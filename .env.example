# Runtime reads ONLY CONTEXT_DATABASE_URL, never another project's DATABASE_URL.
CONTEXT_DATABASE_URL=postgresql://context:context_local@127.0.0.1:5433/context_protocol
# SQLite: sqlite:///./data/context_protocol.db (no extra driver needed)
# MySQL: mysql+pymysql://context:password@127.0.0.1:3306/context_protocol?charset=utf8mb4
